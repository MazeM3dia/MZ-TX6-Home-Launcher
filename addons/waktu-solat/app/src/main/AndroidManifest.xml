<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- JAKIM e-Solat: the zone's times, one request for 35 days. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only for zone Auto, asked for when that is chosen: the box's last known location picks the nearest
         zone. The location never leaves the box; only the zone code goes to JAKIM. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MZ TX6 Home reads the times and sets the zone through this (PrayerProvider). The data is JAKIM's
             public timetable, so it is open to any app on the box. -->
        <provider
            android:name=".PrayerProvider"
            android:authorities="com.mazem3dia.waktusolat"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
