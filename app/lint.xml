<?xml version="1.0" encoding="UTF-8"?>
<!-- The icon and banner are the owner's artwork, one image each: 432 px icon art (xxxhdpi, scaled down by
     Android) and a 640x360 banner (xhdpi). The icon art fills its square on purpose: it is an adaptive icon's
     foreground, which Android masks to the launcher's shape. -->
<lint>
    <issue id="IconLauncherShape" severity="ignore" />
    <issue id="IconDensities" severity="ignore" />
    <issue id="IconMissingDensityFolder" severity="ignore" />
    <!-- Wallpaper reads a photo's rotation with the platform ExifInterface: no AndroidX in this app, and the
         platform class's stream bugs were fixed in Android 7, below minSdk 26. -->
    <issue id="ExifInterface" severity="ignore" />
    <!-- Choose a picture copies one photo; Android 14's "selected photos only" access is not offered (TV boxes
         run older Android). Lint does not honour tools:ignore on the permission for this check. -->
    <issue id="SelectedPhotoAccess" severity="ignore" />
</lint>
