<?xml version="1.0" encoding="utf-8"?>
<!-- The tile's card. It copies the tile's focused state (duplicateParentState). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/tile_focused" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/tile" />
            <corners android:radius="@dimen/tile_radius" />
        </shape>
    </item>
</selector>
