<?xml version="1.0" encoding="utf-8"?>
<!-- The safe area is split between the root (outside) and the scroll view's padding (inside): the padding
     leaves room for a focused tile to grow without being cut off at the edges. The scroll view and grids
     don't clip their children; the FrameLayout around them still clips at the scroll view's edges.
     Button and tile colours come from Palette, set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/root_horizontal"
    android:paddingEnd="@dimen/root_horizontal"
    android:paddingTop="@dimen/safe_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/grow_room"
        android:paddingEnd="@dimen/grow_room">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/time_12"
                android:format24Hour="@string/time_24"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/clock" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date" />
        </LinearLayout>

        <TextView
            android:id="@+id/network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/button_text" />

        <TextView
            android:id="@+id/customize"
            style="@style/TopButton"
            android:layout_marginEnd="16dp"
            android:drawableStart="@drawable/ic_customize"
            android:text="@string/customize" />

        <TextView
            android:id="@+id/settings"
            style="@style/TopButton"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/grow_room"
            android:paddingTop="@dimen/grow_room"
            android:paddingEnd="@dimen/grow_room"
            android:paddingBottom="@dimen/safe_vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dock_header"
                    style="@style/SectionHeader"
                    android:text="@string/favourites" />

                <GridLayout
                    android:id="@+id/dock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal"
                    android:useDefaultMargins="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/apps_header"
                        style="@style/SectionHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/apps" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/options_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/hint_text" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal"
                    android:useDefaultMargins="false" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_apps"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/date"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
