<?xml version="1.0" encoding="utf-8"?>
<!-- The safe area is split between the root (outside) and the scroll view's padding (inside): the padding
     leaves room for a focused tile to grow without being cut off at the edges. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/root_horizontal"
    android:paddingEnd="@dimen/root_horizontal"
    android:paddingTop="@dimen/safe_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/grow_room"
        android:paddingEnd="@dimen/grow_room">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/time_12"
                android:format24Hour="@string/time_24"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/clock" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date" />
        </LinearLayout>

        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:clickable="true"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/grow_room"
            android:paddingTop="@dimen/grow_room"
            android:paddingEnd="@dimen/grow_room"
            android:paddingBottom="@dimen/safe_vertical"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:useDefaultMargins="false" />
        </ScrollView>

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_apps"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/date"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
