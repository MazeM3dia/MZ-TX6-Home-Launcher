<?xml version="1.0" encoding="utf-8"?>
<!-- The glow sits behind everything and takes the focused app's colour (MainActivity.showGlow).
     The safe area is split between the content's padding (outside) and the scroll view's padding (inside): the
     padding leaves room for a focused tile to grow without being cut off at the edges. The scroll view and grids
     don't clip their children; the FrameLayout around them still clips at the scroll view's edges.
     Button, pill, band and tile colours come from Palette, set in code. <merge>: the window's own content frame
     holds the glow and the content, one layer fewer. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/root_horizontal"
        android:paddingEnd="@dimen/root_horizontal"
        android:paddingTop="@dimen/safe_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/grow_room"
            android:paddingEnd="@dimen/grow_room">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    style="@style/Caps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/greeting" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/clock"
                        style="@style/Font.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="@string/time_12"
                        android:fontFeatureSettings="tnum"
                        android:format24Hour="@string/time_24"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/clock" />

                    <!-- AM / PM: hidden in 24-hour mode (MainActivity.onStart). -->
                    <TextClock
                        android:id="@+id/am_pm"
                        style="@style/Font.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:format12Hour="@string/am_pm"
                        android:format24Hour="@string/am_pm"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/clock_suffix" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@color/divider" />

                    <TextClock
                        android:id="@+id/date"
                        style="@style/Caps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="@string/date_header"
                        android:format24Hour="@string/date_header"
                        android:textSize="@dimen/date" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/network"
                style="@style/Font.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/button_text" />

            <TextView
                android:id="@+id/customize"
                style="@style/TopButton"
                android:layout_marginEnd="16dp"
                android:drawableStart="@drawable/ic_customize"
                android:text="@string/customize" />

            <TextView
                android:id="@+id/settings"
                style="@style/TopButton"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/settings" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/header_gap">

            <!-- Keeps the focused tile clear of the header and of the screen's bottom edge (focus_margin_*). -->
            <com.mazem3dia.mztx6home.FocusScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/grow_room"
                android:paddingTop="@dimen/grow_room"
                android:paddingEnd="@dimen/grow_room"
                android:paddingBottom="@dimen/safe_vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <!-- The focused app's name, large, like the original launcher's hero line. -->
                    <TextView
                        android:id="@+id/hero"
                        style="@style/Font.Display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/hero" />

                    <!-- Favourites: no heading, the band shows where they are. -->
                    <FrameLayout
                        android:id="@+id/dock_band"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:padding="@dimen/band_padding">

                        <GridLayout
                            android:id="@+id/dock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:orientation="horizontal"
                            android:useDefaultMargins="false" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/apps_header"
                            style="@style/SectionHeader"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/apps" />

                        <TextView
                            style="@style/Font.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/options_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/hint_text" />
                    </LinearLayout>

                    <GridLayout
                        android:id="@+id/grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal"
                        android:useDefaultMargins="false" />
                </LinearLayout>
            </com.mazem3dia.mztx6home.FocusScrollView>

            <TextView
                android:id="@+id/empty"
                style="@style/Font.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_apps"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</merge>
