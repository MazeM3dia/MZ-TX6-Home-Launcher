<?xml version="1.0" encoding="utf-8"?>
<!-- One app. MainActivity sets the width and the card's 16:9 height, and shows the banner or the icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tile_card"
        android:duplicateParentState="true"
        android:foreground="@drawable/tile_ring">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/tile_icon"
            android:layout_height="@dimen/tile_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:singleLine="true"
        android:textColor="@color/tile_label"
        android:textSize="@dimen/tile_label" />
</LinearLayout>
