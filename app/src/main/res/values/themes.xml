<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tx6Home" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="android:colorAccent">@color/text_primary</item>
        <!-- Home is never animated in or out by the window manager: one less thing for the Mali-T720. -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Inter for every text, menus included. -->
        <item name="android:fontFamily">@font/inter_display_regular</item>
    </style>

    <!-- The three type styles. Every text picks one, so the typeface is set in one place: Inter Display, trimmed to
         Latin (res/font, about 51 KB each; licence in FONT-LICENSE-OFL.txt). -->
    <style name="Font" />
    <style name="Font.Display">
        <item name="android:fontFamily">@font/inter_display_light</item>
    </style>
    <style name="Font.Text">
        <item name="android:fontFamily">@font/inter_display_regular</item>
    </style>
    <style name="Font.Bold">
        <item name="android:fontFamily">@font/inter_display_bold</item>
    </style>

    <!-- Customize and Settings: focusable pills. The background comes from Palette.button(). -->
    <style name="TopButton" parent="Font.Bold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/button_text</item>
    </style>

    <style name="SectionHeader" parent="Font.Bold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/section_text</item>
    </style>

    <!-- Greeting and date: small spaced capitals. -->
    <style name="Caps" parent="Font.Bold">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- The tile menu's window: floating, dimmed behind, see-through so the themed card (tile_menu) is all
         that shows, and no minimum width. -->
    <style name="Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">@font/inter_display_regular</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
</resources>
